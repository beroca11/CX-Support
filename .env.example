# Postgres (compose overrides host to `db`)
DATABASE_URL=postgresql://ees:ees@localhost:5432/ees
PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI Gateway (Vercel AI Gateway or OpenRouter-compatible)
AI_GATEWAY_API_KEY=
MODEL_FAST=openai/gpt-4.1-mini
MODEL_REASON=openai/gpt-4.1
MODEL_WRITE=openai/gpt-4.1-mini
MODEL_EMBED=openai/text-embedding-3-small

# Drive folder of runbooks / known fixes. Blank searches Drive by the issue text.
EES_KB_FOLDER_ID=

# MCP bridge
MCP_BRIDGE_URL=http://mcp-bridge:8100
BRIDGE_MAX_PARALLEL=6
MAX_SOURCE_CHARS=8000

# Picklist sheet. Blank syncs the example sheet backend/src/db/picklists.example.csv.
EES_PICKLIST_SHEET_ID=
